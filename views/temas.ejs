<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Temas</title>
</head>
<body>
    <form action="/temas/crearTema" method="POST">
        <label>Nombre: </label>
        <input type="text" name="nombre" required>
        <button type="submit">Guardar</button>

    </form>

    <ul>
        <% temas.forEach(tema => { %>
        <li>
            <%= tema.nombre %> : <%= tema.votos%> 
        </li>
        <% }); %>
    </ul>
</body>
</html>