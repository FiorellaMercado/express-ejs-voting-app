<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Temas</title>
</head>
<body>
    <form action="/temas/crearTema" method="POST">
        <label>Nombre: </label>
        <input type="text" name="nombre" required>
        <button type="submit">Guardar</button>

    </form>

    <ul>
        <% temas.forEach(tema => { %>
        <li>
            <%= tema.nombre %> : <%= tema.votos%> 
            <form action="/temas/eliminarTema/<%= tema.id%>" method="POST">
                <button>
                    Eliminar
                </button>
            </form> 
            <form action="/temas/traerTema/<%= tema.id%>" method="GET">
                <button>
                    Editar
                </button>
            </form>
            Enlaces:
            <ul>
                <% tema.enlaces.forEach(enlace => { %>
                    <li>
                        <%= enlace %>
                    </li>
                    
                <% }); %>
                
            </ul>
            <form action="/temas/crearEnlace/<%= tema.id %>" method="POST">
                <input type="text" name="enlace" required>
                <button type="submit">Guardar</button>
            </form>
        </li>
        
        <% }); %>
    </ul>
</body>
</html>